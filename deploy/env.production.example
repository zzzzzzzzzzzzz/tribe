# Copy to /opt/tribe/.env on the VPS. Never commit the filled-in file.
DOMAIN=tribe.zzzzzzzzzzzzz.cc
ENVIRONMENT=production
PROJECT_NAME=Tribe
USER_AGENT=Tribe
BACKEND_CORS_ORIGINS=https://tribe.zzzzzzzzzzzzz.cc

# Generate each secret separately: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
POSTGRES_USER=tribe
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=app
FIRST_SUPERUSER=admin@YOUR_EMAIL_DOMAIN
FIRST_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
QDRANT__SERVICE__API_KEY=REPLACE_WITH_RANDOM_KEY

# Public Let's Encrypt contact email; does not need to match FIRST_SUPERUSER.
ACME_EMAIL=YOUR_REAL_EMAIL_ADDRESS

USERS_OPEN_REGISTRATION=False
MAX_WORKERS=1
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1
MAX_MEMORY_PER_CHILD=2048000
MAX_UPLOAD_SIZE=50000000
RECURSION_LIMIT=25
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1

# Add API keys only for providers you intend to use. Empty values are permitted.
OPENAI_API_KEY=
# GigaChat B2B authorization key (credentials); optional until enabled.
# Scope GIGACHAT_API_B2B and the sole model GigaChat-2-Max are set in code.
GIGACHAT_AUTH_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=

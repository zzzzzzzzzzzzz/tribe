# Local development ONLY. Production: deploy/env.production.example
DOMAIN=localhost
ENVIRONMENT=local
PROJECT_NAME=Tribe
USER_AGENT=Tribe
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Replace before exposing this environment outside your own machine.
SECRET_KEY=local-development-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=local-development-password
USERS_OPEN_REGISTRATION=False

POSTGRES_USER=tribe
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=app
POSTGRES_PORT=5432
QDRANT__SERVICE__API_KEY=local-development-qdrant-key

MAX_WORKERS=1
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1
MAX_MEMORY_PER_CHILD=512000
MAX_UPLOAD_SIZE=50000000
RECURSION_LIMIT=25
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1

# Optional provider and observability integrations
OPENAI_API_KEY=
GIGACHAT_AUTH_TOKEN=
ANTHROPIC_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=
